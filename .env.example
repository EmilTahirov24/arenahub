# Local: postgresql://postgres:postgres@localhost:5432/awesome_esports?schema=public
# Prod: any hosted Postgres connection string (Neon, Supabase, Vercel Postgres, Prisma Postgres...)
DATABASE_URL="postgresql://user:password@localhost:5432/awesome_esports?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Bootstrap admin user (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"

# Public site URL, used for sitemap/OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: once set (e.g. after `vercel blob store add` + linking the project),
# image uploads automatically switch from local disk to Vercel Blob — see lib/storage.ts.
BLOB_READ_WRITE_TOKEN=""

# --- Email ------------------------------------------------------------------
# With neither option below configured, verification and password-reset links
# are logged to the server console instead of sent — see lib/email.ts.
#
# Option A: any mailbox over SMTP. Takes precedence when set, and is the only
# one of the two that reaches strangers without owning a domain. For Gmail turn
# on 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and paste it below — your normal
# Google password will not work. Roughly 500 messages a day.
SMTP_USER=""
SMTP_PASS=""
# Defaults suit Gmail; override for another provider. Port 587 uses STARTTLS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# Option B: get a free API key at resend.com. Better deliverability and no daily
# cap, but it will not send to anyone except your own Resend account address
# until you verify a domain with them — which means owning one.
RESEND_API_KEY=""
# Leave as the sandbox sender only while testing. After verifying a domain in
# Resend use e.g. "ArenaHub <noreply@yourdomain.com>". When sending over SMTP
# this is ignored unless it is the SMTP_USER mailbox itself.
EMAIL_FROM="ArenaHub <onboarding@resend.dev>"
