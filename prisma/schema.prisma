// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum MapStatus {
  UPCOMING
  LIVE
  FINISHED
}

enum VetoAction {
  BAN
  PICK
  DECIDER
}

enum TournamentTier {
  S
  A
  B
  C
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum PlayerStatus {
  ACTIVE
  BENCHED
  RETIRED
}

enum AdPlacement {
  HEADER
  SIDEBAR_LEFT
  SIDEBAR_RIGHT_TOP
  SIDEBAR_RIGHT_BOTTOM
  IN_CONTENT
  MATCH_PAGE_TOP
  FOOTER
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ProfileClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Core entities ----------

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String
  accentColor String
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams        Team[]
  players      Player[]
  tournaments  Tournament[]
  matches      Match[]
  newsArticles NewsArticle[]
}

model Team {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  logoUrl        String?
  country        String?
  // Elo-style rating, computed from finished matches by lib/rating.ts — never
  // typed in by hand. `previousRating` is the value before this team's most
  // recent result, so the ranking table can show the movement.
  rating         Float     @default(1000)
  previousRating Float     @default(1000)
  /// Career prize money, entered by an admin from a public source. Unrelated to
  /// TournamentPrize, which only covers tournaments recorded on this site.
  earnings       Int?
  primaryColor   String?
  secondaryColor String?
  description    String?
  isActive       Boolean   @default(true)
  foundedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownerId String?
  owner   Player? @relation("TeamOwner", fields: [ownerId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  memberships       TeamMembership[]
  invites           TeamInvite[]
  tournamentEntries TournamentParticipant[]
  homeMatches       Match[]                 @relation("TeamAMatches")
  awayMatches       Match[]                 @relation("TeamBMatches")
  wonMatches        Match[]                 @relation("MatchWinner")
  wonMaps           MatchMap[]              @relation("MapWinner")
  vetoSteps         MatchVetoStep[]
  playerStats       PlayerMatchStat[]
  relatedNews       NewsArticle[]
  predictedInMatches MatchPrediction[]      @relation("PredictionPick")

  @@index([gameId])
  @@index([ownerId])
}

model Player {
  id        String       @id @default(cuid())
  slug      String       @unique
  nickname  String
  firstName String?
  lastName  String?
  country   String?
  birthDate DateTime?
  photoUrl  String?
  role      String?
  status    PlayerStatus @default(ACTIVE)
  socials   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  email         String?  @unique
  passwordHash  String?
  isClaimed     Boolean  @default(false)
  emailVerified Boolean  @default(false)
  points        Int      @default(0)

  /// Period averages entered by an admin from a public source, for players whose
  /// individual matches are not recorded here. Left null when unknown — never
  /// filled with placeholder numbers, since these describe real people.
  /// PlayerMatchStat still takes precedence where real matches exist.
  statMaps           Int?
  statKillsPerRound  Float?
  statDeathsPerRound Float?
  statDamagePerRound Float?

  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?

  /// Sessions issued before this instant are refused. Session cookies are
  /// stateless 30-day JWTs, so without this a stolen cookie would survive a
  /// password reset. Set when the password changes.
  sessionsValidAfter DateTime?

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  memberships TeamMembership[]
  stats       PlayerMatchStat[]
  predictions MatchPrediction[]
  ownedTeams  Team[]            @relation("TeamOwner")
  invites     TeamInvite[]      @relation("PlayerInvites")
  sentInvites TeamInvite[]      @relation("SentInvites")
  claimsOnMe  ProfileClaim[]    @relation("ClaimedProfile")
  claimsMade  ProfileClaim[]    @relation("Claimant")

  @@index([gameId])
}

/// Someone who registered an account asking to take over a shell profile that
/// was created for them (by an admin, the seed, or a team owner) before they
/// signed up. Always reviewed by an admin: a shell profile carries public match
/// stats and a stable URL, so auto-approving on a name match would let anyone
/// register as a well-known nickname and inherit that player's history.
model ProfileClaim {
  id         String             @id @default(cuid())
  status     ProfileClaimStatus @default(PENDING)
  message    String
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?
  reviewNote String?

  playerId String
  player   Player @relation("ClaimedProfile", fields: [playerId], references: [id], onDelete: Cascade)

  claimantId String
  claimant   Player @relation("Claimant", fields: [claimantId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   AdminUser? @relation(fields: [reviewedById], references: [id])

  @@unique([playerId, claimantId])
  @@index([status])
}

/// A team owner asking an existing, registered player to join their roster.
/// Joining is what makes a self-registered profile publicly listed (see
/// lib/publicPlayers.ts) and ties someone's name to a team, so it needs their
/// consent — the membership is only created once they accept.
model TeamInvite {
  id          String           @id @default(cuid())
  status      TeamInviteStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation("PlayerInvites", fields: [playerId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   Player @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  // One row per (team, player): re-inviting after a decline upserts this row
  // back to PENDING rather than piling up history.
  @@unique([teamId, playerId])
  @@index([playerId, status])
}

model TeamMembership {
  id        String    @id @default(cuid())
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isStandin Boolean   @default(false)
  isCoach   Boolean   @default(false)
  createdAt DateTime  @default(now())

  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@index([teamId])
  @@index([playerId])
}

model Tournament {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  logoUrl   String?
  tier      TournamentTier   @default(B)
  startDate DateTime
  endDate   DateTime
  location  String?
  prizePool String?
  format    String?
  status    TournamentStatus @default(UPCOMING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  participants TournamentParticipant[]
  matches      Match[]
  prizes       TournamentPrize[]

  @@index([gameId])
}

/// One row of a tournament's prize breakdown. The amount belongs to a PLACE
/// RANGE, not to a team — "5-8th places — $60,000" is a single row. A team's
/// prize follows from where its `placement` falls, so it is never stored twice
/// and cannot drift out of sync with the published breakdown.
model TournamentPrize {
  id        String @id @default(cuid())
  placeFrom Int
  placeTo   Int
  amount    Int
  label     String?

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, placeFrom])
  @@index([tournamentId])
}

model TournamentParticipant {
  id        String @id @default(cuid())
  seed      Int?
  placement Int?

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, teamId])
}

model Match {
  id          String      @id @default(cuid())
  slug        String      @unique
  scheduledAt DateTime
  status      MatchStatus @default(UPCOMING)
  bestOf      Int         @default(1)
  teamAScore  Int         @default(0)
  teamBScore  Int         @default(0)
  stage       String?
  isFeatured  Boolean     @default(false)
  starRating  Int         @default(1)
  streamUrl   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  teamAId String
  teamA   Team   @relation("TeamAMatches", fields: [teamAId], references: [id])
  teamBId String
  teamB   Team   @relation("TeamBMatches", fields: [teamBId], references: [id])

  winnerId String?
  winner   Team?   @relation("MatchWinner", fields: [winnerId], references: [id])

  maps         MatchMap[]
  vetoSteps    MatchVetoStep[]
  playerStats  PlayerMatchStat[]
  newsArticles NewsArticle[]
  predictions  MatchPrediction[]

  @@index([gameId])
  @@index([tournamentId])
  @@index([status, scheduledAt])
}

model MatchVetoStep {
  id      String     @id @default(cuid())
  order   Int
  action  VetoAction
  mapName String

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  @@index([matchId])
}

model MatchMap {
  id              String    @id @default(cuid())
  mapOrder        Int
  mapName         String
  teamAScore      Int       @default(0)
  teamBScore      Int       @default(0)
  status          MapStatus @default(UPCOMING)
  durationMinutes Int?

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  winnerId String?
  winner   Team?   @relation("MapWinner", fields: [winnerId], references: [id])

  playerStats PlayerMatchStat[]

  @@unique([matchId, mapOrder])
}

/// Generic top-level columns cover the stats every game shares (kills/deaths/assists/rating)
/// so leaderboards can sort on real indexed columns; game-specific numbers (ADR, GPM, ACS, CS...)
/// live in `coreStats` so new games don't require new tables/migrations.
model PlayerMatchStat {
  id        String @id @default(cuid())
  kills     Int    @default(0)
  deaths    Int    @default(0)
  assists   Int    @default(0)
  rating    Float?
  coreStats Json?

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  mapId String?
  map   MatchMap? @relation(fields: [mapId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  @@index([matchId])
  @@index([playerId])
  @@index([mapId])
}

model NewsArticle {
  id            String    @id @default(cuid())
  slug          String    @unique
  coverImageUrl String?
  tags          String[]
  publishedAt   DateTime?
  isFeatured    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id])

  relatedTeamId String?
  relatedTeam   Team?   @relation(fields: [relatedTeamId], references: [id])

  relatedMatchId String?
  relatedMatch   Match?  @relation(fields: [relatedMatchId], references: [id])

  translations NewsArticleTranslation[]

  @@index([gameId])
  @@index([publishedAt])
}

/// One row per locale ("az" | "en") so UI language and article language stay independent;
/// Team/Player/Tournament names are proper nouns and intentionally not translated.
model NewsArticleTranslation {
  id       String  @id @default(cuid())
  locale   String
  title    String
  excerpt  String?
  bodyHtml String

  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
}

model AdBanner {
  id          String      @id @default(cuid())
  name        String
  placement   AdPlacement
  imageUrl    String
  linkUrl     String
  altText     String?
  startDate   DateTime    @default(now())
  endDate     DateTime?
  weight      Int         @default(1)
  isActive    Boolean     @default(true)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([placement, isActive])
}

model MatchPrediction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  predictedWinnerId String
  predictedWinner   Team   @relation("PredictionPick", fields: [predictedWinnerId], references: [id])

  @@unique([matchId, playerId])
  @@index([matchId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?

  newsArticles  NewsArticle[]
  reviewedClaims ProfileClaim[]
}
