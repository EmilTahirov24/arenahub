# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# uploaded media (local dev storage)
/public/uploads/*
!/public/uploads/.gitkeep

.vercel
.env*
# ...but not the template, which holds no secrets and is the only record of
# which variables the app expects. It was being ignored along with the rest.
!.env.example

scripts/.merge-backup-*.json
scripts/.match-cleanup-*.json
